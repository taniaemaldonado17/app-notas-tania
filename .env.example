# Base de datos PostgreSQL (por ejemplo Neon: https://neon.tech)
# Pegá acá la cadena de conexión que te da el proveedor.
DATABASE_URL=postgresql://usuario:password@host/basededatos?sslmode=require

# Registro de cuentas nuevas. Está cerrado por defecto: ponelo en "true"
# solo cuando quieras crear una cuenta, y después volvé a sacarlo.
NEXT_PUBLIC_ALLOW_REGISTRATION=false

# Secreto para firmar las sesiones JWT de NextAuth.
# Generá uno nuevo ejecutando en la terminal: openssl rand -base64 32
NEXTAUTH_SECRET=cambiame-por-un-secreto-aleatorio-largo

# URL donde se va a acceder a la app.
# - En desarrollo local: http://localhost:3000
# - En Vercel: https://tu-app.vercel.app
# - En otro hosting: https://tu-dominio.com
NEXTAUTH_URL=http://localhost:3000

# Administradoras de la app: emails separados por coma (por ejemplo
# "tania@ejemplo.com,lucas@ejemplo.com"). Solo estas cuentas pueden
# compartir (invitar gente, dar acceso, crear links públicos) y ver
# «Cómputo y presupuesto». Si la dejás vacía, la única administradora es la
# primera cuenta que se creó en la app.
ADMIN_EMAILS=
