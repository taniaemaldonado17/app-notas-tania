# Base de datos PostgreSQL (por ejemplo Neon: https://neon.tech)
# Pegá acá la cadena de conexión que te da el proveedor.
DATABASE_URL=postgresql://usuario:password@host/basededatos?sslmode=require

# Secreto para firmar las sesiones JWT de NextAuth.
# Generá uno nuevo ejecutando en la terminal: openssl rand -base64 32
NEXTAUTH_SECRET=cambiame-por-un-secreto-aleatorio-largo

# URL donde se va a acceder a la app.
# - En desarrollo local: http://localhost:3000
# - En Vercel: https://tu-app.vercel.app
# - En otro hosting: https://tu-dominio.com
NEXTAUTH_URL=http://localhost:3000
