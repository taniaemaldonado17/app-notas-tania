// Prisma schema for Notion-style task management app
// Spanish UI, Argentina, dark mode default

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  pages         Page[]
  sessions      Session[]
  accounts      Account[]
  comments      Comment[]
  uploads       Upload[]
  memberships   PageMember[]
  invitesSent   PageInvite[]  @relation("InviteCreator")
  invitesUsed   PageInvite[]  @relation("InviteUser")
  favorites     Favorite[]
  rowsCreated   DbRow[]
  // Secret for the read-only calendar feed (.ics) the user subscribes to on
  // iPhone / iPad / Google Calendar. Regenerating it revokes the old link.
  // (Plain index, not @unique: adding a unique constraint makes `db push`
  // demand --accept-data-loss, which the Vercel build doesn't pass. Tokens
  // are 192 random bits, so collisions don't happen in practice.)
  calendarToken String?

  @@index([calendarToken])
}

model Page {
  id          String   @id @default(cuid())
  // 'board' = Kanban board (columns/cards); 'databases' = Notion-style databases
  kind        String   @default("board")
  // Dashboard layout of a 'databases' page (stats, linked views, actions)
  layout      Json?
  title       String
  subtitle    String?
  icon        String?
  coverUrl    String?
  // Deprecated: favourites are per user now (see Favorite). Kept so existing
  // data can be migrated; not read or written by the app.
  favorite    Boolean  @default(false)
  members     PageMember[]
  invites     PageInvite[]
  favoritedBy Favorite[]
  databases   Database[]
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  columns     Column[]
  versions    PageVersion[]
  presupuestos Presupuesto[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Column {
  id          String   @id @default(cuid())
  title       String
  position    Int
  accentColor String?
  pageId      String
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  cards       Card[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([pageId])
}

model Card {
  id          String   @id @default(cuid())
  title       String
  description String?
  coverUrl    String?
  accentColor String?
  icon        String?
  // Deprecated: see Favorite.
  favorite    Boolean  @default(false)
  favoritedBy Favorite[]
  position    Int
  columnId    String
  column      Column   @relation(fields: [columnId], references: [id], onDelete: Cascade)
  checklist   ChecklistItem[]
  attachments Attachment[]
  comments    Comment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([columnId])
}

model ChecklistItem {
  id        String   @id @default(cuid())
  text      String
  checked   Boolean  @default(false)
  position  Int
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

model Attachment {
  id        String   @id @default(cuid())
  type      String   // 'pdf' | 'drive' | 'figma' | 'link' | 'file'
  title     String
  url       String   // either /uploads/x.pdf or external URL
  previewUrl String? // optional thumbnail/embed URL
  position  Int
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([cardId])
}

// NextAuth models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// Comments on a card (Notion-style discussion above the content)
model Comment {
  id        String   @id @default(cuid())
  text      String
  // A comment belongs to a Kanban card or to a database row.
  cardId    String?
  card      Card?    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  rowId     String?
  row       DbRow?   @relation(fields: [rowId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([cardId])
  @@index([rowId])
}

// Uploaded files (images, PDFs). Stored in the database because the
// hosting filesystem is not persistent. Served by /api/files/[id].
model Upload {
  id        String   @id @default(cuid())
  name      String
  mimeType  String
  size      Int
  data      Bytes
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

// A user (other than the owner) who can view and edit a shared page.
model PageMember {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([pageId, userId])
  @@index([userId])
}

// Single-use invitation link to a page. Also allows creating an account
// while public registration is closed.
model PageInvite {
  id          String    @id @default(cuid())
  token       String    @unique
  pageId      String
  page        Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  usedById    String?
  usedBy      User?     @relation("InviteUser", fields: [usedById], references: [id], onDelete: SetNull)
  usedAt      DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([pageId])
}

// Personal favourites: a page or a card starred by one user.
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageId    String?
  page      Page?    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  cardId    String?
  card      Card?    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, pageId])
  @@unique([userId, cardId])
}

// A Notion-style database inside a 'databases' page. The schema (typed
// properties) and the saved views live as JSON; see src/lib/db-types.ts.
model Database {
  id          String   @id @default(cuid())
  pageId      String
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  title       String
  icon        String?
  properties  Json
  views       Json
  position    Int      @default(0)
  rows        DbRow[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([pageId])
}

// One row (entry) of a database. Property values are keyed by property id.
// `content` holds the row's page body (same format as Card.description).
model DbRow {
  id          String    @id @default(cuid())
  databaseId  String
  database    Database  @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  title       String    @default("")
  icon        String?
  values      Json      @default("{}")
  content     String?
  position    Float     @default(0)
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  comments    Comment[]
  presupuesto Presupuesto?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([databaseId])
}

// ------------------------------------------------------------------
// Cómputo y presupuesto de obra (costo-costo). Cálculo en
// src/lib/presupuesto/calculo.ts:
//   precio de cálculo del insumo = base x (1 + cargas) si es MO, si no base x coef
//   P.U. del ítem = Σ cantidad x precio de cálculo de sus insumos (APU)
//   cantidad del ítem = Σ parciales de sus mediciones (producto de factores)
// ------------------------------------------------------------------

// A budget belongs to a page (access = page access) and is usually linked
// to a project row of that page (ARQUITECTURA > Proyectos).
model Presupuesto {
  id                 String   @id @default(cuid())
  pageId             String
  page               Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  // Project row. SetNull so restoring a deleted row from history doesn't
  // lose the budget: it can be linked again.
  rowId              String?  @unique
  row                DbRow?   @relation(fields: [rowId], references: [id], onDelete: SetNull)
  nombre             String
  descripcion        String?
  ubicacion          String?
  tipoCambio         Float?
  cargasSociales     Float    @default(0)
  coefAjuste         Float    @default(1)
  superficieCubierta Float?
  superficiePredio   Float?
  // Last computed total, copied to the project row's "Presupuesto" column.
  totalCache         Float    @default(0)
  createdById        String?
  insumos            PresInsumo[]
  rubros             PresRubro[]
  items              PresItem[]
  contrato           Contrato?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([pageId])
}

// ------------------------------------------------------------------
// Certificación de obra (src/lib/certificacion). The contract freezes the
// itemized list (ContratoItem) when it's created: certificates are computed
// on that copy, so later budget edits don't change issued certificates.
// ------------------------------------------------------------------

model Contrato {
  id                String   @id @default(cuid())
  presupuestoId     String   @unique
  presupuesto       Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  montoContrato     Float
  // montoContrato / costo-costo total at freeze time
  coeficientePase   Float    @default(1)
  anticipoPct       Float    @default(0)
  fondoReparoPct    Float    @default(0.05)
  // 'deposito' | 'poliza'
  fondoReparoTipo   String   @default("deposito")
  polizaAseguradora String?
  polizaNumero      String?
  polizaMonto       Float?
  comitente         String?
  contratista       String?
  numero            String?
  mesBasico         String?
  fechaContrato     String?
  fechaInicio       String?
  fechaFin          String?
  plazo             String?
  items             ContratoItem[]
  certificados      Certificado[]
  curva             CurvaPlan[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ContratoItem {
  id               String   @id @default(cuid())
  contratoId       String
  contrato         Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  rubroNumero      Int
  rubroDescripcion String
  codigo           String
  descripcion      String
  unidad           String?
  cantidad         Float
  // Contract unit price (costo-costo P.U. x coeficiente de pase)
  precioUnitario   Float
  importe          Float
  position         Int      @default(0)
  lineas           CertificadoLinea[]

  @@index([contratoId])
}

model Certificado {
  id                       String   @id @default(cuid())
  contratoId               String
  contrato                 Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  numero                   Int
  fecha                    String
  periodo                  String?
  porcentajeAvance         Float
  montoBruto               Float
  montoBrutoAcumulado      Float
  descuentoAnticipo        Float
  anticipoAcumulado        Float
  descuentoFondoReparo     Float
  sustitucionFondoReparo   Float
  fondoReparoAcumulado     Float
  montoNeto                Float
  saldoObra                Float
  saldoAnticipo            Float
  saldoFondoReparo         Float
  rectificado              Boolean  @default(false)
  rectificadoEn            DateTime?
  createdById              String?
  lineas                   CertificadoLinea[]
  createdAt                DateTime @default(now())

  @@unique([contratoId, numero])
}

// Advance of one item in one certificate, as fractions (0-1) of the item.
model CertificadoLinea {
  id              String       @id @default(cuid())
  certificadoId   String
  certificado     Certificado  @relation(fields: [certificadoId], references: [id], onDelete: Cascade)
  contratoItemId  String
  contratoItem    ContratoItem @relation(fields: [contratoItemId], references: [id], onDelete: Cascade)
  anterior        Float
  presente        Float
  acumulado       Float
  importePresente Float

  @@index([certificadoId])
  @@index([contratoItemId])
}

// Planned cumulative progress per period (curva de plan de trabajo).
model CurvaPlan {
  id                  String   @id @default(cuid())
  contratoId          String
  contrato            Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  orden               Int
  periodo             String
  porcentajeAcumulado Float

  @@unique([contratoId, orden])
}

// tipo: MO (mano de obra) | MAT | EQ (equipos) | SUB (subcontratos)
model PresInsumo {
  id            String      @id @default(cuid())
  presupuestoId String
  presupuesto   Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  codigo        String
  descripcion   String
  unidad        String?
  tipo          String
  precioBase    Float       @default(0)
  fuente        String?
  position      Int         @default(0)
  apu           PresApu[]

  @@unique([presupuestoId, codigo])
}

model PresRubro {
  id            String      @id @default(cuid())
  presupuestoId String
  presupuesto   Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  numero        Int
  descripcion   String
  position      Int         @default(0)
  items         PresItem[]

  @@index([presupuestoId])
}

model PresItem {
  id            String         @id @default(cuid())
  presupuestoId String
  presupuesto   Presupuesto    @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  rubroId       String
  rubro         PresRubro      @relation(fields: [rubroId], references: [id], onDelete: Cascade)
  codigo        String
  descripcion   String
  unidad        String?
  observaciones String?
  position      Int            @default(0)
  apu           PresApu[]
  mediciones    PresMedicion[]

  @@index([presupuestoId])
  @@index([rubroId])
}

// Análisis de precio unitario: cuánto de un insumo lleva una unidad del ítem.
model PresApu {
  id       String     @id @default(cuid())
  itemId   String
  item     PresItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  insumoId String
  insumo   PresInsumo @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  cantidad Float      @default(0)
  position Int        @default(0)

  @@index([itemId])
  @@index([insumoId])
}

// Cómputo métrico: parcial = producto de los factores cargados (vacíos no cuentan).
model PresMedicion {
  id       String   @id @default(cuid())
  itemId   String
  item     PresItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  sector   String?
  criterio String?
  cant     Float?
  largo    Float?
  ancho    Float?
  alto     Float?
  coef     Float?
  position Int      @default(0)

  @@index([itemId])
}

// Saved state of a whole page (databases + rows, or board columns + cards),
// taken before changes so the page can be looked back at and restored.
model PageVersion {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  // Who made the change that came right after this state
  userId    String?
  hash      String
  snapshot  Json
  createdAt DateTime @default(now())

  @@index([pageId, createdAt])
}
